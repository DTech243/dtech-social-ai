{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dtech-social-ai",
  "main": "applications/api/src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./applications/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/oauth/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dtech-social-ai-media"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "FRONTEND_URL": "https://social.dtech.cd",
    "META_API_VERSION": "v23.0",
    "META_REDIRECT_URI": "https://social.dtech.cd/api/meta/oauth/callback"
  }
}
